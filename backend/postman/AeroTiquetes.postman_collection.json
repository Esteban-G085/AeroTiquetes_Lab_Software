        {
          "name": "Comprar (carrito con varios viajeros)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/compras",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "compras"
              ]
            },
            "description": "Paga con la billetera. 402 saldo_insuficiente si no alcanza. Maximo 5 tiquetes por vuelo y cliente; menores no pueden viajar solos.",
