    {
      "name": "Compra y reserva (cliente)",
      "description": "Login como CLIENTE y con saldo en la billetera. Root y administrador reciben 403.",
      "item": [
        {
          "name": "Reservar (trayecto unico)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reservas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservas"
              ]
            },
            "description": "Retiene el cupo 24 h (o hasta la salida si falta menos). Un codigo de reserva por viajero, enviado a su correo. Requiere login de CLIENTE.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"trayecto\": \"unico\",\n      \"vuelo_id\": \"{{vueloId}}\",\n      \"clase\": \"economica\",\n      \"viajeros\": [\n        {\n          \"documento\": \"100000001\",\n          \"nombres\": \"Viajero1\",\n          \"apellidos\": \"Prueba\",\n          \"fecha_nacimiento\": \"1990-04-12\",\n          \"genero\": \"femenino\",\n          \"telefono\": \"3001234567\",\n          \"correo\": \"viajero1@example.com\",\n          \"nombre_contacto\": \"Contacto Uno\",\n          \"telefono_contacto\": \"3109876543\"\n        }\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set(\"reservaId\", String(data.id));",
                  "pm.collectionVariables.set(\"tiqueteId\", String(data.tiquetes[0].id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver reserva",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
