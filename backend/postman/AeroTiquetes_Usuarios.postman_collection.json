{
  "info": {
    "name": "AeroTiquetes - Usuarios (B1)",
    "description": "Auth, perfil, administradores y roles. Orden sugerido: 1) Login root, 2) Root y roles, 3) Registro de cliente, 4) Login cliente, 5) Usuarios (perfil).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "rootId",
      "value": "root"
    },
    {
      "key": "rootPassword",
      "value": "CAMBIAR_POR_TU_ROOT_PASSWORD_DEL_.env"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login root",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Guarda el token en la variable {{token}}. Necesario para la carpeta Root.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificador\": \"{{rootId}}\",\n  \"password\": \"{{rootPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", data.access_token);"
                ]
              }
            }
          ]
        },
