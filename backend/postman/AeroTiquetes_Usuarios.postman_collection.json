              ],
              "path": [
                "auth",
                "completar-registro"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "PEGAR_TOKEN_DEL_CORREO"
                }
              ]
            },
            "description": "Devuelve {correo, nombre}. 410 si vencio o ya se uso."
          }
