{
  "info": {
    "name": "AeroTiquetes - Vuelos y Busqueda (B2)",
    "description": "Ciudades, busqueda publica, detalle, panel y programacion de vuelos (HU5, HU18, HU19). Orden sugerido: 0) tener datos (`python -m app.modules.vuelos.seeds`), 1) Login admin y cliente, 2) Ciudades, 3) Busqueda, 4) Administrador. El admin lo crea el root (ver coleccion de Usuarios) y completa su registro; aqui solo se loguea con adminUsuario/adminPassword.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "adminUsuario",
      "value": "CAMBIAR_USUARIO_DEL_ADMIN"
    },
    {
      "key": "adminPassword",
      "value": "CAMBIAR_PASSWORD_DEL_ADMIN"
    },
    {
      "key": "clienteUsuario",
      "value": "anagomez"
    },
    {
      "key": "clientePassword",
      "value": "clavesegura123"
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenCliente",
      "value": ""
    },
    {
      "key": "idVuelo",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Guarda {{tokenAdmin}}.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificador\": \"{{adminUsuario}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"tokenAdmin\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Guarda {{tokenCliente}}. El cliente se registra con la coleccion de Usuarios. Con este token las busquedas quedan en su historial.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificador\": \"{{clienteUsuario}}\",\n  \"password\": \"{{clientePassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"tokenCliente\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        }
      ]
