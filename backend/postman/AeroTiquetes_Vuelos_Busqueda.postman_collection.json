                  "key": "token",
                  "value": "{{tokenCliente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"403 permiso_denegado\", function () { pm.response.to.have.status(403); pm.expect(pm.response.json().error.code).to.eql(\"permiso_denegado\"); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
