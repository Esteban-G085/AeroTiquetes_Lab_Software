          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/vuelos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "vuelos"
              ]
            },
            "description": "Guarda el vuelo; la hora es hora de Colombia. Cambia la fecha a una futura.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"nacional\",\n  \"origen\": \"BOG\",\n  \"destino\": \"MDE\",\n  \"fecha\": \"2030-01-15\",\n  \"hora\": \"08:00\",\n  \"duracion\": 90,\n  \"costo\": 300000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 creado\", function () { pm.response.to.have.status(201); });",
                  "const v = pm.response.json();",
                  "pm.test(\"Lo genera el sistema\", function () { pm.expect(v.codigo).to.match(/^AT-\\d{4}$/); pm.expect(v.estado).to.eql(\"programado\"); pm.expect(v.cupos_economica + v.cupos_primera).to.eql(150); });",
