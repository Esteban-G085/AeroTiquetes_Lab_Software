          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Todos son BOG-MDE\", function () { pm.response.json().items.forEach(v => { pm.expect(v.origen.codigo).to.eql(\"BOG\"); pm.expect(v.destino.codigo).to.eql(\"MDE\"); }); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar combinando filtros",
          "request": {
            "method": "GET",
            "header": [],
