          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "const c = pm.response.json().items.map(v => v.costo);",
                  "pm.test(\"Ordenado por precio desc\", function () { pm.expect(c).to.eql([...c].sort((a,b) => b-a)); });"
                ]
              }
