# Copia este archivo a .env y ajusta los valores. .env NUNCA se sube a Git.

# --- Base de datos ---
DATABASE_URL=postgresql+psycopg://aerotiquetes:aerotiquetes@localhost:5432/aerotiquetes

# --- JWT ---
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRE_MINUTES=30

# --- Root por defecto (se crea automaticamente al arrancar si no existe) ---
ROOT_ID=root
ROOT_PASSWORD=root1234

# --- Correo (Mailpit en desarrollo: docker run -p 1025:1025 -p 8025:8025 axllent/mailpit) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-responder@aerotiquetes.local

# --- Frontend (usado para construir enlaces en los correos) ---
FRONTEND_URL=http://localhost:5173
# Orígenes permitidos por CORS (comparación exacta). Incluir 127.0.0.1 por si el
# front se abre con la URL de red que muestra Vite.
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
