# Copia este archivo a .env y ajusta los valores. .env NUNCA se sube a Git.

# --- Base de datos ---
DATABASE_URL=postgresql+psycopg://aerotiquetes:aerotiquetes@localhost:5432/aerotiquetes

# --- JWT ---
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRE_MINUTES=30

# --- Root por defecto (se crea automaticamente al arrancar si no existe) ---
ROOT_ID=root
ROOT_PASSWORD=root1234

# --- Correo ---
# Gmail es la configuracion por defecto: la app arranca con SMTP real y valida
# que usuario, contrasena y TLS esten presentes. Sin esos datos el arranque falla
# con un mensaje claro (no se puede enviar en claro ni dejar correos sin enviar).
#   1) Activa la verificacion en 2 pasos en la cuenta de Gmail.
#   2) Crea una "contrasena de aplicacion" en https://myaccount.google.com/apppasswords
#   3) Pega los 16 caracteres SIN espacios en SMTP_PASSWORD.
#   SMTP_USER y SMTP_FROM deben ser el mismo Gmail que genero la contrasena.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_FROM=tu_correo@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
#
# Opcion alternativa (solo pruebas locales, sin internet): Mailpit.
# Descomenta estas lineas y comenta las de Gmail. `validar_correo()` omite la
# validacion de credenciales cuando el host es localhost/127.0.0.1/mailpit.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-responder@aerotiquetes.local
# SMTP_USE_TLS=false

# --- Frontend (usado para construir enlaces en los correos) ---
FRONTEND_URL=http://localhost:5173
# Orígenes permitidos por CORS (comparación exacta). Incluir 127.0.0.1 por si el
# front se abre con la URL de red que muestra Vite.
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
