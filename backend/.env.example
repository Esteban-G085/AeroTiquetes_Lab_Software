# Copia este archivo a .env y ajusta los valores. .env NUNCA se sube a Git.

# --- Base de datos ---
DATABASE_URL=postgresql+psycopg://aerotiquetes:aerotiquetes@localhost:5432/aerotiquetes

# --- JWT ---
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRE_MINUTES=30

# --- Root por defecto (se crea automaticamente al arrancar si no existe) ---
ROOT_ID=root
ROOT_PASSWORD=root1234

# --- Correo ---
# Opcion A (recomendada para la entrega): SMTP real de Gmail.
#   1) Activa la verificacion en 2 pasos en la cuenta.
#   2) Crea una "contrasena de aplicacion" en https://myaccount.google.com/apppasswords
#   3) Pega los 16 caracteres SIN espacios en SMTP_PASSWORD.
#   SMTP_USER y SMTP_FROM deben ser el mismo Gmail que genero la contrasena.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# SMTP_FROM=tu_correo@gmail.com
#
# Opcion B (desarrollo local sin internet): Mailpit (docker compose lo levanta).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-responder@aerotiquetes.local

# --- Frontend (usado para construir enlaces en los correos) ---
FRONTEND_URL=http://localhost:5173
# Orígenes permitidos por CORS (comparación exacta). Incluir 127.0.0.1 por si el
# front se abre con la URL de red que muestra Vite.
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
